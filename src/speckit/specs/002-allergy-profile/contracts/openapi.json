{
  "openapi": "3.0.3",
  "info": {
    "title": "NutriViet Allergy Profile API",
    "version": "1.0.0",
    "description": "API contract for FG2 Personal Allergy Profile Management adhering to Spec Kit."
  },
  "paths": {
    "/api/v1/profile/allergens": {
      "get": {
        "summary": "Get configured allergens for a user",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns list of configured allergens with severities"
          }
        }
      },
      "post": {
        "summary": "Save or update user allergen profile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["user_id", "allergens"],
                "properties": {
                  "user_id": { "type": "integer" },
                  "allergens": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["code", "name", "severity"],
                      "properties": {
                        "code": { "type": "string" },
                        "name": { "type": "string" },
                        "severity": { "type": "string", "enum": ["high", "moderate", "mild"] }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully"
          }
        }
      }
    }
  }
}
