{
  "openapi": "3.0.3",
  "info": {
    "title": "NutriViet Packaging OCR Scanner & History API",
    "version": "1.0.0",
    "description": "API contract for FG3 Packaging OCR Scanner (UC06, UC07, UC08) adhering to NutriViet Spec Kit standards."
  },
  "paths": {
    "/api/v1/ocr/normalize": {
      "post": {
        "summary": "Clean, normalize raw OCR text and extract food additives (UC07)",
        "operationId": "normalizeOcrText",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["raw_text"],
                "properties": {
                  "raw_text": {
                    "type": "string",
                    "description": "Raw, unfiltered text string captured from ML Kit camera OCR",
                    "example": "Thành phần: Bột mì, Đường, Đậu phộng (12%), Dầu cọ, Chất nhũ hóa (E322i, INS 471), Muối. HSD: 12/2027"
                  },
                  "lang": {
                    "type": "string",
                    "enum": ["vi", "en"],
                    "default": "vi",
                    "description": "Language code for localized functional names"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cleaned, normalized text and structured additives list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "raw_text": { "type": "string" },
                    "cleaned_text": { "type": "string" },
                    "normalized_text": { "type": "string" },
                    "tokens": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "extracted_e_numbers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": { "type": "string" },
                          "standard_code": { "type": "string" },
                          "name": { "type": "string" },
                          "category": { "type": "string" },
                          "risk": { "type": "string" }
                        }
                      }
                    },
                    "token_count": { "type": "integer" },
                    "additive_count": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input payload or empty raw_text"
          }
        }
      }
    },
    "/api/v1/scans": {
      "get": {
        "summary": "Retrieve user scan history with safety metrics (UC08)",
        "operationId": "getUserScanHistory",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": { "type": "integer" },
            "description": "ID of authenticated user"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50 }
          }
        ],
        "responses": {
          "200": {
            "description": "Chronological scan history list and monthly aggregations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "user_id": { "type": "integer" },
                    "scans": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "integer" },
                          "member_name": { "type": "string" },
                          "label_title": { "type": "string" },
                          "raw_text": { "type": "string" },
                          "normalized_text": { "type": "string" },
                          "verdict": { "type": "string", "enum": ["RED", "YELLOW", "GREEN"] },
                          "risk_level": { "type": "string", "enum": ["high", "low", "safe"] },
                          "risk_label_vi": { "type": "string" },
                          "additive_count": { "type": "integer" },
                          "warning_count": { "type": "integer" },
                          "evaluation": { "type": "object" },
                          "created_at": { "type": "string" }
                        }
                      }
                    },
                    "total_scans": { "type": "integer" },
                    "warning_scans": { "type": "integer" },
                    "monthly_scans": { "type": "integer" },
                    "monthly_warnings": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing user_id parameter"
          }
        }
      },
      "post": {
        "summary": "Process packaging label scan, normalize text, evaluate allergens, and persist session (UC06, UC07, UC08)",
        "operationId": "createScanSession",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["user_id", "raw_text"],
                "properties": {
                  "user_id": { "type": "integer" },
                  "raw_text": { "type": "string" },
                  "label_title": { "type": "string", "default": "Kết quả quét" },
                  "member_name": { "type": "string", "default": "" },
                  "lang": { "type": "string", "default": "vi" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scan session evaluated and persisted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "latest_scan": { "type": "object" },
                    "scans": { "type": "array" },
                    "total_scans": { "type": "integer" },
                    "warning_scans": { "type": "integer" },
                    "monthly_scans": { "type": "integer" },
                    "monthly_warnings": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing user_id or empty raw_text"
          }
        }
      },
      "delete": {
        "summary": "Delete a scan session from history (UC08)",
        "operationId": "deleteScanSession",
        "parameters": [
          {
            "name": "scan_id",
            "in": "query",
            "required": true,
            "schema": { "type": "integer" }
          },
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Scan deleted successfully"
          },
          "400": {
            "description": "Missing scan_id"
          },
          "404": {
            "description": "Scan record not found"
          }
        }
      }
    }
  }
}